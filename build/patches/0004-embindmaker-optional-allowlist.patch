+// If the LO_EMBIND_ALLOWLIST environment variable names a file, only the UNO entities listed
+// there (one per line; '#' starts a comment) are bound, together with everything needed to use
+// them from JS: base interfaces, struct and exception members, the service's interface, and the
+// parameter, return and exception types of the listed interfaces' methods and attributes.  This
+// keeps the generated code, and so the WASM binary, small for embedders that need only a few
+// UNO APIs.
+std::set<OUString> const* allowlist = nullptr;
+
+bool allowed(OUString const& name) { return allowlist == nullptr || allowlist->count(name) != 0; }
+
+void addToAllowlist(rtl::Reference<TypeManager> const& manager, OUString const& name, bool deep,
+                    std::set<OUString>& allow, std::set<OUString>& deepened)
+{
+    if (name.startsWith("[]") || name.indexOf('<') != -1)
+    {
+        OUString nucleus;
+        sal_Int32 rank;
+        std::vector<OUString> args;
+        manager->decompose(name, true, &nucleus, &rank, &args, nullptr);
+        addToAllowlist(manager, nucleus, deep, allow, deepened);
+        for (auto const& arg : args)
+        {
+            addToAllowlist(manager, arg, false, allow, deepened);
+        }
+        return;
+    }
+    rtl::Reference<unoidl::Entity> ent;
+    auto const sort = manager->getSort(name, &ent);
+    switch (sort)
+    {
+        case codemaker::UnoType::Sort::Typedef:
+            addToAllowlist(manager, static_cast<unoidl::TypedefEntity*>(ent.get())->getType(),
+                           deep, allow, deepened);
+            return;
+        case codemaker::UnoType::Sort::Enum:
+        case codemaker::UnoType::Sort::PlainStruct:
+        case codemaker::UnoType::Sort::PolymorphicStructTemplate:
+        case codemaker::UnoType::Sort::Exception:
+        case codemaker::UnoType::Sort::Interface:
+        case codemaker::UnoType::Sort::ConstantGroup:
+        case codemaker::UnoType::Sort::SingleInterfaceBasedService:
+        case codemaker::UnoType::Sort::InterfaceBasedSingleton:
+            break;
+        default:
+            return;
+    }
+    bool const added = allow.insert(name).second;
+    bool const deepen = deep && sort == codemaker::UnoType::Sort::Interface
+                        && deepened.insert(name).second;
+    if (!added && !deepen)
+    {
+        return;
+    }
+    auto const add = [&](OUString const& type) {
+        addToAllowlist(manager, type, false, allow, deepened);
+    };
+    switch (sort)
+    {
+        case codemaker::UnoType::Sort::PlainStruct:
+        {
+            auto const ent2 = static_cast<unoidl::PlainStructTypeEntity*>(ent.get());
+            if (!ent2->getDirectBase().isEmpty())
+            {
+                add(ent2->getDirectBase());
+            }
+            for (auto const& mem : ent2->getDirectMembers())
+            {
+                add(mem.type);
+            }
+            break;
+        }
+        case codemaker::UnoType::Sort::PolymorphicStructTemplate:
+            for (auto const& mem :
+                 static_cast<unoidl::PolymorphicStructTypeTemplateEntity*>(ent.get())->getMembers())
+            {
+                if (!mem.parameterized)
+                {
+                    add(mem.type);
+                }
+            }
+            break;
+        case codemaker::UnoType::Sort::Exception:
+        {
+            auto const ent2 = static_cast<unoidl::ExceptionTypeEntity*>(ent.get());
+            if (!ent2->getDirectBase().isEmpty())
+            {
+                add(ent2->getDirectBase());
+            }
+            for (auto const& mem : ent2->getDirectMembers())
+            {
+                add(mem.type);
+            }
+            break;
+        }
+        case codemaker::UnoType::Sort::Interface:
+        {
+            auto const ent2 = static_cast<unoidl::InterfaceTypeEntity*>(ent.get());
+            for (auto const& base : ent2->getDirectMandatoryBases())
+            {
+                add(base.name);
+            }
+            for (auto const& base : ent2->getDirectOptionalBases())
+            {
+                add(base.name);
+            }
+            if (deepen)
+            {
+                for (auto const& att : ent2->getDirectAttributes())
+                {
+                    add(att.type);
+                    for (auto const& exc : att.getExceptions)
+                    {
+                        add(exc);
+                    }
+                    for (auto const& exc : att.setExceptions)
+                    {
+                        add(exc);
+                    }
+                }
+                for (auto const& meth : ent2->getDirectMethods())
+                {
+                    add(meth.returnType);
+                    for (auto const& param : meth.parameters)
+                    {
+                        add(param.type);
+                    }
+                    for (auto const& exc : meth.exceptions)
+                    {
+                        add(exc);
+                    }
+                }
+                // Also deepen the bases, so their methods are usable on the derived interface:
+                for (auto const& base : ent2->getDirectMandatoryBases())
+                {
+                    addToAllowlist(manager, base.name, true, allow, deepened);
+                }
+            }
+            break;
+        }
+        case codemaker::UnoType::Sort::SingleInterfaceBasedService:
+        {
+            auto const ent2 = static_cast<unoidl::SingleInterfaceBasedServiceEntity*>(ent.get());
+            addToAllowlist(manager, ent2->getBase(), true, allow, deepened);
+            for (auto const& ctor : ent2->getConstructors())
+            {
+                for (auto const& param : ctor.parameters)
+                {
+                    add(param.type);
+                }
+                for (auto const& exc : ctor.exceptions)
+                {
+                    add(exc);
+                }
+            }
+            break;
+        }
+        case codemaker::UnoType::Sort::InterfaceBasedSingleton:
+            addToAllowlist(manager,
+                           static_cast<unoidl::InterfaceBasedSingletonEntity*>(ent.get())->getBase(),
+                           true, allow, deepened);
+            break;
+        default:
+            break;
+    }
+}
+
+void readAllowlist(rtl::Reference<TypeManager> const& manager, char const* pathname,
+                   std::set<OUString>& allow)
+{
+    std::ifstream in(pathname);
+    if (!in)
+    {
+        std::cerr << "Cannot read LO_EMBIND_ALLOWLIST file \"" << pathname << "\"\n";
+        std::exit(EXIT_FAILURE);
+    }
+    std::set<OUString> deepened;
+    std::string line;
+    while (std::getline(in, line))
+    {
+        auto const hash = line.find('#');
+        if (hash != std::string::npos)
+        {
+            line.erase(hash);
+        }
+        OUString const name(b2u(line).trim());
+        if (!name.isEmpty())
+        {
+            addToAllowlist(manager, name, true, allow, deepened);
+        }
+    }
+}
+
+// Drop modules that ended up without any (transitively) allowed content:
+bool pruneModule(Module& module)
+{
+    for (auto it = module.modules.begin(); it != module.modules.end();)
+    {
+        if (pruneModule(*it->second))
+        {
+            it = module.modules.erase(it);
+        }
+        else
+        {
+            ++it;
+        }
+    }
+    return module.modules.empty() && module.mappings.empty();
+}
