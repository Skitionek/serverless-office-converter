{
  "name": "Office Converter",
  "short_name": "Office Converter",
  "description": "Convert office documents in the browser. Nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f9",
  "theme_color": "#0f7d02",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.oasis.opendocument.text": [
          ".odt",
          ".ott",
          ".fodt",
          ".sxw",
          ".stw",
          ".doc",
          ".dot",
          ".docx",
          ".docm",
          ".dotx",
          ".dotm",
          ".rtf",
          ".txt",
          ".html",
          ".htm",
          ".xhtml",
          ".md",
          ".markdown",
          ".hwp",
          ".xml"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods",
          ".ots",
          ".fods",
          ".sxc",
          ".stc",
          ".xls",
          ".xlt",
          ".xlsx",
          ".xlsm",
          ".xltx",
          ".xltm",
          ".xlsb",
          ".csv",
          ".tsv",
          ".tab",
          ".wk1",
          ".wks",
          ".123",
          ".dif",
          ".slk",
          ".sylk",
          ".wb2",
          ".uos"
        ],
        "application/vnd.oasis.opendocument.presentation": [
          ".odp",
          ".otp",
          ".fodp",
          ".sxi",
          ".sti",
          ".ppt",
          ".pps",
          ".pot",
          ".pptx",
          ".pptm",
          ".ppsx",
          ".ppsm",
          ".potx",
          ".potm"
        ],
        "application/vnd.oasis.opendocument.graphics": [
          ".odg",
          ".otg",
          ".fodg",
          ".sxd",
          ".std",
          ".svg",
          ".svgz",
          ".wmf",
          ".emf",
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".bmp",
          ".tif",
          ".tiff",
          ".webp",
          ".eps",
          ".pct",
          ".pict",
          ".pcx",
          ".ppm",
          ".pgm",
          ".pbm",
          ".ras",
          ".tga",
          ".xbm",
          ".xpm",
          ".met",
          ".cgm"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
