diff --git a/external/icu/ExternalProject_icu.mk b/external/icu/ExternalProject_icu.mk
index d7b45f4c0..467530ab2 100644
--- a/external/icu/ExternalProject_icu.mk
+++ b/external/icu/ExternalProject_icu.mk
@@ -66,9 +66,25 @@ icu_LDFLAGS:=" \
 # DATASUBDIR=data in cross-compiling case, because --disable-tools completely skips the
 # data directory/doesn't build the requested library in that case (icu/source/Makefile.in)
 # so we need to add it back to the list of subdirectories to build
+#
+# For WASM, drop the locale-specific display names (of languages, regions, currencies, units and
+# time zones) from the prebuilt ICU data: LibreOffice has its own tables for these and only uses the
+# ICU ones in UI language lists, and they are almost half of the data that ends up in the binary.
+# The root, pool and supplemental bundles stay, so lookups still fall back gracefully.
+icu_WASM_STRIP_DATA = \
+	( export LD_LIBRARY_PATH=$(WORKDIR_FOR_BUILD)/UnpackedTarball/icu/source/lib && \
+	icupkg=$(WORKDIR_FOR_BUILD)/UnpackedTarball/icu/source/bin/icupkg && \
+	$$icupkg -l data/in/icudt$(ICU_MAJOR)l.dat > wasm-all-data.lst && \
+	{ grep -E '^(curr|lang|region|unit|zone)/' wasm-all-data.lst \
+		| grep -v -E '/(pool|root|supplementalData|tzdbNames)\.res$$' > wasm-strip-data.lst \
+		|| true; } && \
+	if test -s wasm-strip-data.lst; then \
+		$$icupkg -r wasm-strip-data.lst data/in/icudt$(ICU_MAJOR)l.dat; fi ) &&
+
 $(call gb_ExternalProject_get_state_target,icu,build) :
 	$(call gb_Trace_StartRange,icu,EXTERNAL)
 	$(call gb_ExternalProject_run,build,\
+		$(if $(and $(filter EMSCRIPTEN,$(OS)),$(ENABLE_WASM_STRIP_LOCALES)),$(icu_WASM_STRIP_DATA)) \
 		autoconf -f && \
 		CPPFLAGS=$(icu_CPPFLAGS) CFLAGS=$(icu_CFLAGS) \
 		CXXFLAGS=$(icu_CXXFLAGS) LDFLAGS=$(icu_LDFLAGS) \
