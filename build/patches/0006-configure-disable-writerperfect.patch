diff --git a/configure.ac b/configure.ac
index 0add5fbd3..e1f01e86b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2309,6 +2309,13 @@ AC_ARG_ENABLE(opengl,
         [Disable OpenGL support.]),
 ,enable_opengl=yes)
 
+libo_FUZZ_ARG_ENABLE(writerperfect,
+    AS_HELP_STRING([--disable-writerperfect],
+        [Do not build the librevenge-based import filters (writerperfect: Visio, Publisher,
+         Keynote/Pages/Numbers, CorelDRAW, WordPerfect, Works, old Mac formats, StarOffice 5,
+         QuarkXPress, FreeHand, PageMaker, AbiWord, e-books) nor the EPUB export.]),
+,enable_writerperfect=yes)
+
 libo_FUZZ_ARG_ENABLE(librelogo,
     AS_HELP_STRING([--disable-librelogo],
         [Do not build LibreLogo.]),
@@ -10374,6 +10381,16 @@ AC_SUBST([ENABLE_EOT])
 dnl ===================================================================
 dnl Check for DLP libs
 dnl ===================================================================
+ENABLE_WRITERPERFECT=TRUE
+if test "$enable_writerperfect" = no; then
+    ENABLE_WRITERPERFECT=
+    for lib in libabw libcdr libebook libepubgen libetonyek libfreehand libmspub libmwaw libodfgen \
+               libpagemaker libqxp librevenge libstaroffice libvisio libwpd libwpg libwps libzmf; do
+        eval test_$lib=no
+    done
+fi
+AC_SUBST(ENABLE_WRITERPERFECT)
+
